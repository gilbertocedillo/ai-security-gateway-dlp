# Copy to .env - NEVER commit the real .env
OPENAI_API_KEY=sk-your-key-here
FINAL_LLM_MODEL=gpt-4o-mini
CLASSIFIER_MODEL=gpt-4o-mini

# n8n incident logging - Supabase REST insert endpoint OR any webhook receiver writing to Postgres
INCIDENT_WEBHOOK_URL=https://your-project.supabase.co/rest/v1/incidents
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Gateway behaviour
STRICT_DLP_BLOCK=true
LLM_CLASSIFIER_ENABLED=false
BLOCK_THRESHOLD=70
